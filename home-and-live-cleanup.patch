+.hm-tile{--acc:#3dc9ae;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
+  width:clamp(130px,17vw,220px);aspect-ratio:1/1.08;padding:12px;border:2px solid #ffffff22;border-radius:22px;color:#fff;font:inherit;cursor:pointer;text-align:center;
+  background:linear-gradient(160deg,#ffffff14,#ffffff06);transition:transform .22s,border-color .22s,box-shadow .22s,background .22s;
+  animation:hmrise .7s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:calc(.5s + var(--i,0) * .1s)}
+.hm-tile.vod{--acc:#e8b34a}
