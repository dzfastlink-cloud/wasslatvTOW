+.hm-tile .hm-lb{font-size:clamp(16px,1.9vw,24px);font-weight:700}
+.hm-tile .hm-sub{font-size:clamp(11px,1.15vw,15px);color:#a8d1c9;min-height:1.2em}
+.hm-tile.dim{opacity:.6}
+.hm-tile.sel,.hm-tile:focus-visible{outline:none;transform:scale(1.09);border-color:var(--acc);background:linear-gradient(160deg,color-mix(in srgb,var(--acc) 38%,transparent),#ffffff0d);box-shadow:0 0 0 4px color-mix(in srgb,var(--acc) 35%,transparent),0 18px 40px #000b}
+.hm-tile.sel::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 35%,#ffffff2e 50%,transparent 65%);transform:translateX(-120%);animation:hmsweep 1.6s ease-in-out .15s infinite}
+.hm-hint{position:relative;font-size:clamp(11px,1.2vw,15px);color:#9fcfc6}
